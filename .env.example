# Copy to .env (or .env.local) and fill in. NEXT_PUBLIC_* values are sent to the browser.

# Next.js sets this itself (development for `npm run dev`, production for builds).
# It also turns on the development-only tools: Switch user, the business switcher and the data-mode toggle.
NODE_ENV=development

# Where the portal's data comes from:
#   mock = the built-in sample data in src/data (no backend needed)
#   live = Supabase project NWT-Main (needs sign-in)
# In development the header's data-mode toggle can override this for the current browser.
NEXT_PUBLIC_DATA_MODE=mock

# Supabase project NWT-Main (Project Settings → API Keys). Use the publishable key (sb_publishable_...),
# which is safe in the browser because RLS decides what each signed-in user can see.
# Never put a secret key (sb_secret_...) in the client.
NEXT_PUBLIC_SUPABASE_URL=https://ufrictpsiwoqaakdcrxd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
